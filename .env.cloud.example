# ==========================================
# Smart Home Bot — Cloud Deployment (.env)
# ==========================================
# Скопируй этот файл в .env и заполни значения.

# Режим: webhook (для Render/облака)
WEBHOOK_MODE=true

# Telegram
BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# Tuya Smart (управление светом — работает из облака)
TUYA_ACCESS_ID=YOUR_TUYA_ACCESS_ID
TUYA_SECRET=YOUR_TUYA_SECRET
TUYA_DEVICE_ID=YOUR_TUYA_DEVICE_ID
TUYA_REGION_URL=https://openapi.tuyaeu.com

# Доступ (Telegram User ID через запятую)
ALLOWED_USERS=YOUR_TELEGRAM_ID

# API-ключ для Sisyphus (оповещения о завершении задач)
SISYPHUS_API_KEY=YOUR_SISYPHUS_API_KEY

# Базовый URL — Render подставит автоматически (RENDER_EXTERNAL_URL)
# Не нужно задавать вручную!
# BASE_URL=

# ─── Локальные сервисы (не работают в облаке) ───
# PC_IP=           # qBittorrent — только локально
# PC_MAC=          # Wake-on-LAN — только локально
# PC_USER=         # SSH — только локально
# QB_USER=         # qBittorrent — только локально
# QB_PASS=         # qBittorrent — только локально
# RUTRACKER_USER=  # Поиск фильмов — работает из облака
# RUTRACKER_PASS=  # Но загрузка — нет (нужен qBittorrent локально)
